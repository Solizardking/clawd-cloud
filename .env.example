# Clawd Core AI — operator environment
# Copy to .env and fill locally. Never commit a filled copy.

# Chain
HELIUS_API_KEY=
HELIUS_NETWORK=mainnet
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Models
XAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROK_MODEL=grok-4.6

# Connectors
DFLOW_API_KEY=
JUPITER_API_KEY=
BIRDEYE_API_KEY=

# Memory / docs
MEMBRAIN_GRPC_ENDPOINT=localhost:9090
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Dashboards
TAILCLAWD_HOST=127.0.0.1
TAILCLAWD_PORT=4402
