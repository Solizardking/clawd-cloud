{
  "name": "@clawd/core",
  "version": "1.0.0",
  "description": "Identity umbrella and machine-readable catalog for the Clawd Core AI stack",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./catalog": "./src/catalog.mjs"
  },
  "bin": {
    "clawd-core": "src/cli.mjs"
  },
