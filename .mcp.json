{
  "mcpServers": {
    "DFlow": {
      "type": "http",
      "url": "https://api.paybox.sh/mcp?app=dflow"
    },
    "Helius": {
      "type": "http",
      "url": "https://api.helius.dev/mcp"
    },
    "Jupiter": {
      "type": "http",
      "url": "https://api.jup.ag/mcp"
    },
    "Birdeye": {
      "type": "http",
      "url": "https://public-api.birdeye.so/mcp"
    },
    "zkcompression": {
      "type": "http",
      "url": "https://www.zkcompression.com/mcp"
    },
    "clawd-mcp": {
      "command": "npx",
      "args": ["-y", "clawd-mcp@latest"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY}",
        "SOLANA_RPC_URL": "${SOLANA_RPC_URL}"
      }
    },
    "solana-mcp": {
      "type": "http",
      "url": "http://localhost:8080/mcp"
    },
    "pump-mcp": {
      "command": "npm",
      "args": ["run", "mcp:pump:start"]
    }
  }
}
